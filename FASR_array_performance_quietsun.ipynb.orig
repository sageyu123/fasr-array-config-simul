{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "1f8f59145b135b9d",
   "metadata": {},
   "source": [
    "# Imaging Performance Comparison (Quiet Sun)\n",
    "This notebook loops over different noise levels and calibration errors to generate, corrupt, image, and compare solar flare datasets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 100,
   "id": "5ac3515306586a4f",
   "metadata": {},
   "outputs": [],
   "source": [
    "import fasr_solar_simul as fss\n",
    "import matplotlib\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.special import j1\n",
    "from scipy.constants import c\n",
    "import os\n",
    "from casatasks import tclean, applycal, clearcal\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "from tqdm import tqdm\n",
    "import timeit\n",
    "\n",
    "# Speed of light in m/s\n",
    "C_LIGHT = c\n",
    "import matplotlib\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 101,
   "id": "b62f24ccfb5f3617",
   "metadata": {},
   "outputs": [],
   "source": [
    "from importlib import reload\n",
    "\n",
    "reload(fss)\n",
    "target = 'Quiet_Sun'\n",
    "figsubfolder = 'figs/'\n",
    "model_dir = '../fasr_sim/skymodels/quiet_sun/'"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7a727e664a6ace40",
   "metadata": {},
   "source": [
    "# Imaging Performance Comparison\n",
    "looping over different noise levels and calibration errors to generate, corrupt, image, and compare"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8bb6a8b12e1f5f61",
   "metadata": {},
   "source": [
    "## Set up the simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 102,
   "id": "edd51399162f05de",
   "metadata": {},
   "outputs": [],
   "source": [
    "# List of all available frequencies in GHz\n",
    "freq_list = ['1GHz', '2GHz', '5GHz', '10GHz', '20GHz']\n",
    "imsizes = [512, 512, 1024, 2048, 4096]\n",
    "cells = ['4.8arcsec', '4.8arcsec', '2.4arcsec', '1.2arcsec', '0.6arcsec']\n",
    "scales = [[0, 5, 10, 50], [0, 4, 10, 40], [0, 6, 20, 80], [0, 5, 10, 40, 160], [0, 10, 40, 80, 320]]\n",
    "#freq_list = ['1GHz', '10GHz']\n",
    "#imsizes = [512, 2048]\n",
    "#cells = ['4.8arcsec', '1.2arcsec']\n",
    "#scales = [[0, 5, 10, 50], [0, 5, 10, 40, 160]]\n",
    "\n",
    "# List of configurations\n",
    "project = 'FASR-A'\n",
    "config_files = ['fasr_Log_Spiral-168.cfg', 'fasr-a_random_spiral_hybrid_120.cfg']\n",
    "\n",
    "## Antenna temperature noise levels\n",
    "noise_levels = ['0.005MK', '0.01MK'][:1]\n",
    "\n",
    "## Define the fractional gain errors tuples: (phase and amplitude)\n",
    "# 6 degrees (or 1.7% of phase error is equivalent to 10% of amplitude error )\n",
    "#cal_errors = [(0., 0.), (0.017, 0.1)]\n",
    "cal_errors = [(0., 0.)]\n",
    "\n",
    "# Reference timestamp for the observation series\n",
    "reftime_obj = datetime(2020, 11, 26, 20, 0, 0)\n",
    "\n",
    "# Flags to control overwriting existing data products\n",
    "overwrite_ms   = False  # Overwrite measurement set?\n",
    "overwrite_im   = False  # Overwrite image products?\n",
    "overwrite_plot = True  # Overwrite existing plots?\n",
    "\n",
    "# Deconvolution algorithm choice\n",
    "#deconvolver = 'hogbom'\n",
    "#niter = 0\n",
    "#weighting = 'uniform'\n",
    "\n",
    "deconvolver = 'multiscale'\n",
    "niter = 10000\n",
    "\n",
    "# Imaging parameters (in seconds)\n",
    "integration_time = 1  # Time per integration\n",
    "duration         = 1  # Total imaging duration"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6c86418d21deba13",
   "metadata": {},
   "source": [
    "## Simulate visibility and image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "id": "ea4e723206233703",
   "metadata": {},
